CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_TWO_OTA=y

# The capture trigger (adctrig) lives in the RF test library, which is only
# linked with this option.
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
# The periodic PLL-tracking timer would retune the radio under the scanner.
CONFIG_ESP_PHY_DISABLE_PLL_TRACK=y

# Speed: 240 MHz, 1 kHz tick, optimise for performance.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# The node task never blocks; the idle task does not get to run.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n

# Keep static data well below the capture bank at 0x40820000.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_PM_ENABLE=n
# Code out of IRAM: RH's eight nodes alone need ~14 KB of BSS, and all static
# data must end below the capture bank (tools/check_phy.py checks _bss_end).
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y

# Logs on UART0 only, and quiet: the native USB port belongs to RotorHazard,
# which must read nothing it did not ask for. WARN also silences the
# capture trigger's own prints.
# No ESP-IDF console at all: the native USB port and (on the TX/RX pads)
# UART0 carry RotorHazard's binary protocol. The app's own '!' console on
# USB is unaffected. The ROM still prints its boot banner on UART0 at
# 115200; RotorHazard reads past it.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
